<Window x:Class="UsageTrackerWidget.App.Views.UsageFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UsageTrackerWidget.App.Views"
        Title="Usage Tracker"
        Width="432"
        MaxHeight="790"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        Loaded="OnLoaded"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown"
        Closing="OnClosing">

    <Window.Resources>
        <DataTemplate x:Key="QuotaWindowTemplate">
            <Border Margin="0,0,0,9"
                    Padding="14"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0"
                                    Padding="6,2"
                                    CornerRadius="5"
                                    Visibility="{Binding ShowStatusBadge, Converter={StaticResource BoolToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StateKind}" Value="off">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StateKind}" Value="unknown">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StateKind}" Value="limit">
                                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusLabel}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StateKind}" Value="off">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateKind}" Value="unknown">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateKind}" Value="limit">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding UsedPercentText}"
                                   FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCriticalUsage}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 Margin="0,9,0,0"
                                 Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}">
                        <ProgressBar.Style>
                            <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource QuotaProgressBarStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighUsage}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCriticalUsage}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <Grid Grid.Row="2" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding RemainingText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11.5" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ResetText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11.5"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding WindowLengthText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10.5" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding HistoryRangeLabel}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10.5"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <views:HistorySparkline Grid.Row="4"
                                            Height="30"
                                            Margin="0,8,0,0"
                                            Points="{Binding History}"
                                            LineBrush="{DynamicResource AccentBrush}"
                                            ResetBrush="{DynamicResource WarningBrush}"
                                            GuideBrush="{DynamicResource TrackBrush}"
                                            Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="IssueTemplate">
            <Border Margin="0,0,0,7"
                    Padding="10,8"
                    Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Detail}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding Message}"
                               Margin="0,3,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  ShadowDepth="8"
                                  Direction="270"
                                  Opacity="0.45"
                                  Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,16,14,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36"
                            Height="36"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="11">
                        <TextBlock Text="U"
                                   FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Usage Tracker"
                                   FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11.5" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource IconButtonStyle}"
                            Click="OnCloseClick"
                            ToolTip="Close"
                            AutomationProperties.Name="Close usage details"
                            Content="✕"
                            FontSize="12" />
                </Grid>

                <Border Grid.Row="0"
                        VerticalAlignment="Bottom"
                        Height="1"
                        Background="{DynamicResource DividerBrush}" />

                <ScrollViewer Grid.Row="1"
                              MaxHeight="690"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AppScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <StackPanel Margin="20,14,14,18">

                        <Border Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="15"
                                Margin="0,0,0,14"
                                Visibility="{Binding ShowConnectPanel, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Connect Codex"
                                           FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="Sign in through OpenAI to read your usage. Usage Tracker keeps its own protected token and never reads credentials from another app." />
                                <Button Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SignInCommand}"
                                        Content="Sign in to Codex" />
                                <ProgressBar Height="3"
                                             Margin="0,11,0,0"
                                             IsIndeterminate="True"
                                             Background="{DynamicResource TrackBrush}"
                                             Foreground="{DynamicResource AccentBrush}"
                                             BorderThickness="0"
                                             Visibility="{Binding IsLoginInProgress, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Margin="0,9,0,0"
                                           Text="{Binding LoginMessage}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasLoginMessage, Converter={StaticResource BoolToVisibility}}" />
                                <TextBox Margin="0,8,0,0"
                                         MaxHeight="62"
                                         Text="{Binding LoginUrl, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Visibility="{Binding HasLoginUrl, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Style="{StaticResource LinkButtonStyle}"
                                            Command="{Binding OpenSignInPageCommand}"
                                            Content="Open sign-in page"
                                            Visibility="{Binding HasLoginUrl, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Margin="10,0,0,0"
                                            Style="{StaticResource LinkButtonStyle}"
                                            Command="{Binding CancelSignInCommand}"
                                            Content="Cancel sign-in"
                                            Visibility="{Binding IsLoginInProgress, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Codex"
                                           FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource CaptionTextStyle}">
                                    <Run Text="{Binding AccountText, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding PlanText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="READ-ONLY"
                                       Style="{StaticResource SectionLabelStyle}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Windows}"
                                      ItemTemplate="{StaticResource QuotaWindowTemplate}" />

                        <ItemsControl Margin="0,3,0,0"
                                      ItemsSource="{Binding Issues}"
                                      ItemTemplate="{StaticResource IssueTemplate}" />

                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,4,0,12"
                                Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Settings"
                                           FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,9" />
                                <CheckBox Content="Start with Windows"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                          Margin="0,0,0,7" />
                                <CheckBox Content="Track daily image allowance"
                                          IsChecked="{Binding TrackImageAllowance, Mode=TwoWay}"
                                          Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Text="Uses a deliberately incomplete image request that Codex rejects before generating anything." />

                                <Border Height="1"
                                        Margin="0,12,0,11"
                                        Background="{DynamicResource DividerBrush}" />

                                <TextBlock Text="Pin beside the clock"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="Windows controls notification-area placement. Open Taskbar settings → Other system tray icons → Usage Tracker and turn it on. If it is in overflow, drag it onto the taskbar." />

                                <Border Height="1"
                                        Margin="0,12,0,11"
                                        Background="{DynamicResource DividerBrush}" />

                                <Grid Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                                    <Button HorizontalAlignment="Left"
                                            Style="{StaticResource LinkButtonStyle}"
                                            Command="{Binding RequestDisconnectCommand}"
                                            Content="Disconnect Codex"
                                            Visibility="{Binding IsConfirmingDisconnect, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding IsConfirmingDisconnect, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Disconnect Codex?"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,8,0" />
                                        <Button Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding DisconnectCommand}"
                                                Content="Disconnect"
                                                Padding="8,4" />
                                        <Button Margin="6,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding CancelDisconnectCommand}"
                                                Content="Keep connected"
                                                Padding="8,4" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Margin="0,10,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="Credentials use Windows DPAPI for this user. History stores percentages, reset times, and plan label only—never tokens, account IDs, or emails." />

                                <Button Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Command="{Binding ExitCommand}"
                                        Content="Exit Usage Tracker" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding LastUpdatedText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}">
                                    <Run Text="Auto-refresh " />
                                    <Run Text="{Binding RefreshIntervalText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding RefreshCommand}"
                                        Content="Refresh"
                                        Padding="12,7" />
                                <Button Margin="6,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ToggleSettingsCommand}"
                                        Content="Settings"
                                        Padding="12,7" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
